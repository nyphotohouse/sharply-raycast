{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "sharply",
  "title": "Sharply",
  "description": "Find photography gear and open its Sharply page.",
  "icon": "extension-icon.png",
  "author": "camerongustavson",
  "license": "MIT",
  "categories": [
    "Productivity",
    "Web"
  ],
  "commands": [
    {
      "name": "search-gear",
      "title": "Search Gear",
      "subtitle": "Sharply",
      "description": "Search published cameras and lenses and open their Sharply pages.",
      "mode": "view"
    }
  ],
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "lint": "ray lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@raycast/api": "latest",
    "@raycast/utils": "latest"
  },
  "devDependencies": {
    "@raycast/eslint-config": "latest",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0"
  }
}
